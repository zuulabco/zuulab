  {
    "id": "foreignKey.orders.orders_campaign_id_fkey",
    "label": "Add foreign key \"orders_campaign_id_fkey\" on \"orders\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "orders_campaign_id_fkey",
        "table": "orders"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"orders_campaign_id_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "orders_campaign_id_fkey",
          "public",
          "\"public\".\"orders\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"orders_campaign_id_fkey\"",
        "sql": "ALTER TABLE \"public\".\"orders\"\nADD CONSTRAINT \"orders_campaign_id_fkey\"\nFOREIGN KEY (\"campaign_id\")\nREFERENCES \"public\".\"campaigns\" (\"id\")\nON DELETE SET NULL\nON UPDATE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"orders_campaign_id_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "orders_campaign_id_fkey",
          "public",
          "\"public\".\"orders\""
        ]
      }
    ]
  }
