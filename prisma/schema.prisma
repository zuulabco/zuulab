  productId        String                   @map("product_id")
  sku              String
  barcode          String?
  productName      String                   @map("product_name")
  expectedQuantity Int                      @map("expected_quantity")
  countedQuantity  Int?                     @map("counted_quantity")
  varianceQuantity Int?                     @map("variance_quantity")
  status           WarehouseCountLineStatus @default(PENDING)
  countedAt        DateTime?                @map("counted_at")
  countedBy        String?                  @map("counted_by")
  recountCount     Int                      @default(0) @map("recount_count")
  countHistory     Json?                    @map("count_history")
  notes            String?                  @db.Text
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  session          WarehouseCountSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tickets          WarehouseReconciliationTicket[]

  @@index([sessionId])
  @@index([locationId])
  @@index([productId])
  @@index([status])
  @@map("warehouse_count_lines")
}

model WarehouseReconciliationTicket {
  id               String                        @id @default(cuid())
  ticketNumber     String                        @unique @map("ticket_number")
  countSessionId   String                        @map("count_session_id")
  countLineId      String                        @map("count_line_id")
  storeId          String?                       @map("store_id")
  locationId       String                        @map("location_id")
  locationCode     String                        @map("location_code")
  productId        String                        @map("product_id")
  sku              String
  productName      String                        @map("product_name")
  expectedQuantity Int                           @map("expected_quantity")
  countedQuantity  Int                           @map("counted_quantity")
  varianceQuantity Int                           @map("variance_quantity")
  status           WarehouseReconciliationStatus @default(OPEN)
  reason           String                        @db.Text
  createdBy        String                        @map("created_by")
  reviewedBy       String?                       @map("reviewed_by")
  approvedAt       DateTime?                     @map("approved_at")
  resolvedAt       DateTime?                     @map("resolved_at")
  resolution       String?                       @db.Text
  auditReference   String?                       @map("audit_reference")
  idempotencyKey   String                        @unique @map("idempotency_key")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  session          WarehouseCountSession         @relation(fields: [countSessionId], references: [id], onDelete: Cascade)
  line             WarehouseCountLine            @relation(fields: [countLineId], references: [id], onDelete: Cascade)

  @@index([countSessionId])
  @@index([countLineId])
  @@index([storeId])
  @@index([status])
  @@map("warehouse_reconciliation_tickets")
}

model WarehouseCarton {
  id              String   @id @default(cuid())
  storeId         String?  @map("store_id")
  code            String   @unique
  name            String
  innerLengthMm   Int      @map("inner_length_mm")
  innerWidthMm    Int      @map("inner_width_mm")
  innerHeightMm   Int      @map("inner_height_mm")
  maxWeightGrams  Int      @map("max_weight_grams")
  tareWeightGrams Int      @default(0) @map("tare_weight_grams")
  active          Boolean  @default(true)
  priority        Int      @default(10)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([active])
  @@index([priority])
  @@map("warehouse_cartons")
}

// ─────────────────────────────────────────────────────────────
// PHASE 23 — PRODUCTION ORDERS
// ─────────────────────────────────────────────────────────────

model ProductionOrder {
  id                    String             @id @default(cuid())
  productId             String             @map("product_id")
  productNameSnapshot   String             @map("product_name_snapshot")
  skuSnapshot           String             @map("sku_snapshot")
  quantity              Int
  completedQuantity     Int                @default(0) @map("completed_quantity")
  acceptedQuantity      Int                @default(0) @map("accepted_quantity")
  failedQuantity        Int                @default(0) @map("failed_quantity")
  status                ProductionStatus   @default(PLANNED)
  priority              ProductionPriority @default(NORMAL)
  printerReference      String?            @map("printer_reference")
  notes                 String?            @db.Text
  stockedIdempotencyKey String?            @unique @map("stocked_idempotency_key")
  createdBy             String             @map("created_by")
  startedAt             DateTime?          @map("started_at")
  completedAt           DateTime?          @map("completed_at")
  stockedAt             DateTime?          @map("stocked_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  product               Product            @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("production_orders")
}

// ─────────────────────────────────────────────────────────────
// PHASE 24 — PRODUCT ECONOMICS & COST PROFILES
// ─────────────────────────────────────────────────────────────

model MaterialProfile {
  id            String   @id @default(cuid())
  storeId       String?  @map("store_id")
  name          String   @unique
  pricePerKgTl  Decimal  @db.Decimal(10, 2) @map("price_per_kg_tl")
  currency      String   @default("TRY")
  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now()) @map("effective_from")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([active])
  @@map("material_profiles")
}

model ChannelFeeConfig {
  id                         String   @id @default(cuid())
  storeId                    String?  @map("store_id")
  channel                    String   @map("channel") // DIRECT | TRENDYOL | HEPSIBURADA
  commissionPercent          Decimal? @db.Decimal(5, 2) @map("commission_percent")
  commissionFixedTl          Decimal? @db.Decimal(10, 2) @map("commission_fixed_tl")
  estimatedShippingCostTl    Decimal? @db.Decimal(10, 2) @map("estimated_shipping_cost_tl")
  estimatedPaymentFeePercent Decimal? @db.Decimal(5, 2) @map("estimated_payment_fee_percent")
  estimatedPaymentFeeFixedTl Decimal? @db.Decimal(10, 2) @map("estimated_payment_fee_fixed_tl")
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@unique([storeId, channel], name: "store_channel_fee_config")
  @@index([channel])
  @@map("channel_fee_configs")
}

// ─────────────────────────────────────────────────────────────
// PHASE 29 — MATERIAL STOCK & INVENTORY
// ─────────────────────────────────────────────────────────────

enum MaterialMovementType {
  PURCHASE
  MANUAL_ADJUSTMENT
  PRODUCTION_CONSUMPTION
  WASTE
  RETURN
}

model MaterialStock {
  id                   String                  @id @default(cuid())
  storeId              String?                 @map("store_id")
  materialProfileId    String?                 @map("material_profile_id")
  materialName         String                  @map("material_name")
  color                String?                 @map("color")
  quantityGrams        Decimal                 @default(0) @db.Decimal(12, 2) @map("quantity_grams")
  minimumQuantityGrams Decimal                 @default(1000) @db.Decimal(12, 2) @map("minimum_quantity_grams")
  location             String?                 @map("location")
  isActive             Boolean                 @default(true) @map("is_active")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  movements            MaterialStockMovement[]

  @@unique([storeId, materialName, color], name: "store_material_color_unique")
  @@index([storeId])
  @@index([materialProfileId])
  @@index([materialName])
  @@index([isActive])
  @@map("material_stocks")
}

model MaterialStockMovement {
  id                    String               @id @default(cuid())
  materialStockId       String               @map("material_stock_id")
  type                  MaterialMovementType @map("type")
  quantityGrams         Decimal              @db.Decimal(12, 2) @map("quantity_grams")
  previousQuantityGrams Decimal              @db.Decimal(12, 2) @map("previous_quantity_grams")
  newQuantityGrams      Decimal              @db.Decimal(12, 2) @map("new_quantity_grams")
  reason                String               @db.Text @map("reason")
  reference             String?              @map("reference")
  idempotencyKey        String?              @unique @map("idempotency_key")
  createdBy             String               @map("created_by")
  createdAt             DateTime             @default(now()) @map("created_at")

  stock                 MaterialStock        @relation(fields: [materialStockId], references: [id], onDelete: Cascade)

  @@index([materialStockId])
  @@index([type])
  @@index([createdAt])
  @@map("material_stock_movements")
}


// Fixed-window request counters shared by every server instance
// (src/lib/security/rate-limiter.ts). Rows are tiny and pruned as they expire.
model RateLimit {
  key          String   @id
  count        Int
  windowEndsAt DateTime @map("window_ends_at")

  @@index([windowEndsAt])
  @@map("rate_limits")
}

// ─────────────────────────────────────────────────────────────
// MARKETPLACES (Trendyol, Hepsiburada) — several stores per marketplace
// ─────────────────────────────────────────────────────────────
model MarketplaceStore {
  id                 String    @id @default(cuid())
  provider           String // TRENDYOL | HEPSIBURADA
  name               String
  // Trendyol seller (supplier) id / Hepsiburada merchant id
  externalSellerId   String    @map("external_seller_id")
  environment        String    @default("PRODUCTION") // PRODUCTION | STAGE
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE | ERROR
  // Write switches; reading (orders, products) is always allowed for ACTIVE stores.
  stockSyncEnabled   Boolean   @default(false) @map("stock_sync_enabled")
  priceSyncEnabled   Boolean   @default(false) @map("price_sync_enabled")
  orderImportEnabled Boolean   @default(true) @map("order_import_enabled")
  // Marketplace price = site price * (1 + markup/100), e.g. to cover commission.
  priceMarkupPercent Decimal   @default(0) @db.Decimal(5, 2) @map("price_markup_percent")
  lastConnectionAt   DateTime? @map("last_connection_at")
  lastOrderSyncAt    DateTime? @map("last_order_sync_at")
  lastError          String?   @map("last_error") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  credential         MarketplaceCredential?

  @@unique([provider, externalSellerId, environment])
  @@map("marketplace_stores")
}

// API credentials, AES-256-GCM encrypted with MARKETPLACE_CREDENTIALS_KEY.
model MarketplaceCredential {
  id              String           @id @default(cuid())
  storeId         String           @unique @map("store_id")
  apiKeyEncrypted String           @map("api_key_encrypted") @db.Text
  apiSecretEncrypted String        @map("api_secret_encrypted") @db.Text
  // Last 4 characters of the key, to recognise it in the admin without decrypting.
  apiKeyHint      String           @map("api_key_hint")
  version         Int              @default(1)
  rotatedAt       DateTime         @default(now()) @map("rotated_at")

  store           MarketplaceStore @relation(fields:[storeId], references:[id], onDelete: Cascade)

  @@map("marketplace_credentials")
}
