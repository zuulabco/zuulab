  SKU
  CYCLE
  SPOT_CHECK
  FULL_AUDIT
}

enum WarehouseCountSessionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  COUNTED
  UNDER_REVIEW
  RECOUNT_REQUIRED
  APPROVED
  RECONCILED
  CANCELLED
}

enum WarehouseCountLineStatus {
  PENDING
  COUNTED
  UNDER_REVIEW
  RECOUNT_REQUIRED
  VERIFIED
  RECONCILED
  CANCELLED
}

enum WarehouseReconciliationStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CANCELLED
}

model WarehouseCountSession {
  id             String                      @id @default(cuid())
  storeId        String?                     @map("store_id")
