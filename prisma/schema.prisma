enum WarehouseLocationType {
  WAREHOUSE
  ZONE
  AISLE
  RACK
  SHELF
  BIN
}

model WarehouseLocation {
  id                 String                @id @default(cuid())
  warehouseId        String                @default("MAIN") @map("warehouse_id")
  parentId           String?               @map("parent_id")
  code               String                @unique
  name               String
  type               WarehouseLocationType @default(BIN)
  zone               String?
  aisle              String?
  rack               String?
  shelf              String?
  bin                String?
  capacity           Int                   @default(100)
  weightCapacityGrams Decimal?             @db.Decimal(10, 2) @map("weight_capacity_grams")
  isActive           Boolean               @default(true) @map("is_active")
  isPickable         Boolean               @default(true) @map("is_pickable")
  isPutawayAllowed   Boolean               @default(true) @map("is_putaway_allowed")
  sortOrder          Int                   @default(0) @map("sort_order")
  metadata           Json?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  parent             WarehouseLocation?    @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           WarehouseLocation[]   @relation("LocationHierarchy")
  inventories        LocationInventory[]
  sourceMovements    InventoryLocationMovement[] @relation("SourceMovements")
  destinationMovements InventoryLocationMovement[] @relation("DestinationMovements")

  @@index([warehouseId])
  @@index([parentId])
  @@index([type])
  @@index([zone])
  @@index([isActive])
  @@map("warehouse_locations")
}

model LocationInventory {
  id               String            @id @default(cuid())
  warehouseId      String            @default("MAIN") @map("warehouse_id")
  locationId       String            @map("location_id")
  productId        String            @map("product_id")
  sku              String
  quantity         Int               @default(0)
  reservedQuantity Int               @default(0) @map("reserved_quantity")
  lotNumber        String?           @map("lot_number")
  batchInfo        String?           @map("batch_info")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  location         WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId], name: "location_product_unique")
  @@index([locationId])
  @@index([productId])
  @@index([sku])
  @@map("location_inventories")
}

enum InventoryLocationMovementType {
  PUTAWAY
  RELOCATION
  PICK
  RETURN_RESTOCK
  DAMAGE
  COUNT_ADJUSTMENT
  QUARANTINE
}

model InventoryLocationMovement {
  id                    String                         @id @default(cuid())
  warehouseId           String                         @default("MAIN") @map("warehouse_id")
  movementType          InventoryLocationMovementType  @map("movement_type")
  sourceLocationId      String?                        @map("source_location_id")
  destinationLocationId String?                        @map("destination_location_id")
  productId             String                         @map("product_id")
  sku                   String
  quantity              Int
  operatorId            String                         @map("operator_id")
  referenceId           String?                        @map("reference_id")
  idempotencyKey        String                         @unique @map("idempotency_key")
  notes                 String?                        @db.Text
  metadata              Json?
  createdAt             DateTime                       @default(now()) @map("created_at")

  sourceLocation        WarehouseLocation?             @relation("SourceMovements", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocation   WarehouseLocation?             @relation("DestinationMovements", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([movementType])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([productId])
  @@index([sku])
  @@map("inventory_location_movements")
}

