# Zuulab E-Commerce Platform — Environment Variables Example
# Copy this file to `.env.local` for development. Never commit actual secret keys to version control.

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
# PostgreSQL connection string for Prisma ORM.
# Compatible with Neon, Supabase, AWS RDS, or local PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/zuulab_db?schema=public"

# ==============================================================================
# FIREBASE AUTHENTICATION (CLIENT)
# ==============================================================================
# Public client credentials from Firebase Console -> Project Settings -> General
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="zuulab-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="zuulab-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="zuulab-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==============================================================================
# FIREBASE ADMIN SDK (SERVER-SIDE TOKEN VERIFICATION)
# ==============================================================================
# Service account credentials from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID="zuulab-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@zuulab-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional secret for cross-subdomain SSO session signing (defaults to hash of FIREBASE_PRIVATE_KEY)
AUTH_SESSION_SECRET="your-secure-32-byte-hex-or-base64-secret"
# Emails granted ADMIN on first sign-in (comma-separated, Firebase-verified emails only)
ADMIN_BOOTSTRAP_EMAILS=""

# ==============================================================================
# CLOUDINARY (MEDIA STORAGE)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="zuulab"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# PAYMENT GATEWAY (PayTR)
# ==============================================================================
# PAYTR in every deployed environment; SANDBOX only for local development
PAYMENT_PROVIDER="PAYTR"

# PayTR Production / Sandbox Credentials
PAYTR_MERCHANT_ID="your_paytr_merchant_id"
PAYTR_MERCHANT_KEY="your_paytr_merchant_key"
PAYTR_MERCHANT_SALT="your_paytr_merchant_salt"
PAYTR_TEST_MODE="1" # "1" for PayTR test/sandbox environment, "0" for live production


# Webhook Secret & Cron Maintenance Security
PAYMENT_WEBHOOK_SECRET="secure_random_hex_string_for_webhook_signatures"
CRON_SECRET="secure_bearer_token_for_scheduled_tasks"

# ==============================================================================
# INVOICE GATEWAY (Uyumsoft e-Fatura / e-Arşiv)
# ==============================================================================
# Active invoice provider: UYUMSOFT | MOCK
INVOICE_PROVIDER="UYUMSOFT"

# Environment: TEST (https://efatura-test.uyumsoft.com.tr) | PRODUCTION (https://efatura.uyumsoft.com.tr)
UYUMSOFT_ENV="TEST"

# Uyumsoft Integration Credentials
UYUMSOFT_USERNAME="your_uyumsoft_username"
UYUMSOFT_PASSWORD="your_uyumsoft_password"
UYUMSOFT_COMPANY_CODE="your_company_code"

# ==============================================================================
# SHIPPING & FULFILLMENT GATEWAYS (Phase 11 Multi-Carrier: Sürat / Yurtiçi / Mock)
# ==============================================================================
# Default outbound carrier: SURAT | YURTICI | MOCK
SHIPPING_PROVIDER="MOCK"
OUTBOUND_SHIPPING_PROVIDER="MOCK"

# Default return / reverse logistics carrier (can be different from outbound):
RETURN_SHIPPING_PROVIDER="MOCK"

# Sürat Kargo Web Service Credentials (SOAP / Direct API)
# Official service: https://webservices.suratkargo.com.tr/services.asmx
SURAT_CUSTOMER_CODE="your_surat_customer_code"
SURAT_PASSWORD="your_surat_password"
SURAT_WEB_SERVICE_URL="https://webservices.suratkargo.com.tr/services.asmx"

# Yurtiçi Kargo Web Service Credentials
YURTICI_WS_USERNAME="your_yurtici_ws_username"
YURTICI_WS_PASSWORD="your_yurtici_ws_password"
YURTICI_USER_LANGUAGE="TR"
YURTICI_TEST_MODE="true"
# Production URL: https://services.yurticikargo.com:8080/KOPSWebServices/ShippingOrderDispatcherServices
# Test URL: https://testservices.yurticikargo.com:9053/KOPSWebServices/ShippingOrderDispatcherServices
YURTICI_ENDPOINT_URL="https://testservices.yurticikargo.com:9053/KOPSWebServices/ShippingOrderDispatcherServices"

# Carrier Webhook Security (hex HMAC-SHA256 of raw body; required in production)
SHIPPING_WEBHOOK_SECRET="secure_random_carrier_webhook_secret"

# Marketplace webhook credentials (value sent back as x-api-key / Authorization; required in production)
TRENDYOL_WEBHOOK_SECRET=""
HEPSIBURADA_WEBHOOK_SECRET=""

# Marketplace API keys are stored AES-256-GCM encrypted with this key (32 random bytes,
# e.g. `openssl rand -base64 32`). Changing it makes saved keys unreadable: re-enter them.
MARKETPLACE_CREDENTIALS_KEY=""

# ==============================================================================
# PHASE 10: TRANSACTIONAL NOTIFICATIONS & EMAIL
# ==============================================================================
# Active Email Provider: "MOCK" for local/CI/test, "RESEND" for production
EMAIL_PROVIDER="MOCK"

# Resend Transactional Email API (https://resend.com)
# Production requires an active API key and verified sending domain
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"
RESEND_FROM_EMAIL="ZUULAB <siparis@zuulab.com>"
# Inbox that receives new support tickets and contact-form messages (defaults to RESEND_FROM_EMAIL)
SUPPORT_INBOX_EMAIL=""

# Optional Delivery Secret for Notification Queue Processing (Vercel Cron)
CRON_SECRET="secure_random_cron_secret"

# ==============================================================================
# MAINTENANCE MODE
# ==============================================================================
# Set to "true" to display maintenance page on public storefront routes.
# Set to "false" for normal production store operations.
MAINTENANCE_MODE="false"

# Comma-separated list of IPv4 and/or IPv6 addresses authorized to bypass maintenance.
# Example: "192.168.1.50,203.0.113.195"
MAINTENANCE_ALLOWED_IPS=""
